-- Quartus Prime generated Memory Initialization File (.mif)

WIDTH=16;
DEPTH=64;

ADDRESS_RADIX=UNS;
DATA_RADIX=BIN;

CONTENT BEGIN
    0 : 0000000110001000; -- ADD 6, 2 -> A    | A = 8
    1 : 0001100000001110; -- SUB A, 3 -> B    | B = 5
    2 : 0010010010001001; -- MUL 2, B -> C    | C = 10
    3 : 0011110001001000; -- DIV C, B -> A    | A = 2
    4 : 0000100000000010; -- MOV A -> B       | B = 2 (soma A com 0 e guarda em B)
    5 : 0111000000001000; -- CMP A, B         | A == B (2 == 2) -> rescomp = 1
    6 : 0101001000000000; -- JE 8             | Pula para o endereco 8 (pula o 7)
    7 : 0000001111000000; -- TRAP (NAO EXEC)  | A = 15

    8 : 0001100001101001; -- SUB C, 10 -> C   | C = 0
    9 : 0110001011010000; -- JZ 11, C         | Se C == 0, pula para o endereco 11 (pula o 10)
   10 : 0000001111000000; -- TRAP (NAO EXEC)  | A = 15

   11 : 0100001101000000; -- JMP 13           | Pula incondicionalmente para o endereco 13 (pula o 12)
   12 : 0000001111000000; -- TRAP (NAO EXEC)  | A = 15

   13 : 1100000000000000; -- RST              | Reseta registradores e contador do programa

   [14..63] : 0000000000000000; -- NOP / Zeros
END;